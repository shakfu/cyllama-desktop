{
  "name": "cyllama-desktop",
  "productName": "Cyllama Desktop",
  "version": "0.1.0",
  "description": "Desktop app for cyllama (Electron + bundled Python sidecar)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --enable-logging",
    "vendor": "bash scripts/copy-vendor.sh",
    "build:renderer": "esbuild src/renderer/src/main.js --bundle --outfile=src/renderer/dist/renderer.js --format=iife --target=chrome120 --sourcemap=inline && esbuild src/preferences/main.js --bundle --outfile=src/preferences/dist/preferences.js --format=iife --target=chrome120 --sourcemap=inline",
    "watch:renderer": "esbuild src/renderer/src/main.js --bundle --outfile=src/renderer/dist/renderer.js --format=iife --target=chrome120 --sourcemap=inline --watch",
    "test:e2e": "npm run build:renderer && playwright test",
    "build:python": "bash scripts/build-python-env.sh",
    "build:mac-arm64": "npm run build:renderer && electron-builder --mac --arm64",
    "build:mac-x64": "npm run build:renderer && electron-builder --mac --x64",
    "build:win": "npm run build:renderer && electron-builder --win --x64",
    "build:linux": "npm run build:renderer && electron-builder --linux --x64",
    "postinstall": "npm run vendor"
  },
  "author": "Shakeeb Alireza",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@playwright/test": "^1.59.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "katex": "^0.16.11",
    "marked": "^14.1.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
